# Supplier Panel Environment Variables
VITE_API_BASE_URL=http://192.168.1.114:5000/api

# API Endpoints
VITE_LOGIN_API=/supplier/login
VITE_FORGOT_PASSWORD_API=/supplier/forgot-password
VITE_GET_PROFILE_API=/supplier/profile
VITE_UPDATE_PROFILE_API=/supplier/profile
VITE_CHANGE_PASSWORD_API=/supplier/change-password
VITE_GET_SUPPLIER_ASSIGNED_TASKS_API=/supplier/my-assigned-tasks
VITE_GET_SUPPLIER_MAINTENANCE_DETAILS_API=/supplier/maintenance/:id
VITE_RESPOND_SUPPLIER_MAINTENANCE_API=/supplier/maintenance/:id/respond
VITE_SUPPLIER_TIMER_API=/supplier/timer
VITE_SUPPLIER_CDS_SHEET_API=/supplier/maintenance/:id/cds-sheet
VITE_GET_PARTS_API=/dealer/parts
VITE_SUPPLIER_PART_REQUESTS_API=/supplier/part-requests
VITE_SUPPLIER_COMPLETE_TASK_API=/supplier/maintenance/:id/complete-task
