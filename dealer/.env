# Dealer Panel Environment Variables
VITE_API_BASE_URL=http://192.168.1.30:4000/api

# API Endpoints
VITE_LOGIN_API=/dealers/login
VITE_FORGOT_PASSWORD_API=/dealers/forgot-password
VITE_CHANGE_PASSWORD_API=/dealers/change-password
VITE_GET_PROFILE_API=/dealers/profile
VITE_UPDATE_PROFILE_API=/dealers/update-profile
VITE_VAN_STEP_1_API=/dealer/vans/step-1
VITE_VAN_STEP_2_API=/dealer/vans/:vanId/step-2
VITE_VAN_STEP_3_API=/dealer/vans/:vanId/step-3
VITE_VAN_STEP_4_API=/dealer/vans/:vanId/step-4
VITE_VAN_STEP_5_API=/dealer/vans/:vanId/step-5/upload
VITE_VAN_STEP_6_API=/dealer/vans/:vanId/step-6
VITE_VAN_REVIEW_API=/dealer/vans/:vanId/review
VITE_VAN_PUBLISH_API=/dealer/vans/:vanId/publish
VITE_VAN_PROGRESS_API=/dealer/vans/:vanId/progress
VITE_GET_COMPONENTS_API=/dealer/vans/components
VITE_GET_VANS_API=/dealer/vans/get
VITE_GET_VAN_DETAILS_API=/dealer/vans/get/:vanId
VITE_GET_OWNERS_API=/dealer/vans/get/owners
VITE_GET_OWNERS_LIST_API=/dealer/vans/get/owners/list
VITE_GET_OWNER_DETAILS_API=/dealer/vans/get/owner/:ownerId
VITE_GET_DASHBOARD_API=/dealer/dashboard
VITE_GET_TECHNICIANS_BY_DEALER_API=/technician/by-dealer
VITE_GET_TECHNICIAN_DETAILS_BY_DEALER_API=/technician/by-dealer/:id
VITE_TOGGLE_BLOCK_TECHNICIAN_API=/technician/by-dealer/:id/block
VITE_DELETE_TECHNICIAN_API=/technician/by-dealer/:id
VITE_GET_SUPPLIERS_BY_DEALER_API=/supplier/by-dealer
VITE_GET_SUPPLIER_DETAILS_BY_DEALER_API=/supplier/by-dealer/:id
VITE_TOGGLE_BLOCK_SUPPLIER_API=/supplier/by-dealer/:id/block
VITE_DELETE_SUPPLIER_API=/supplier/by-dealer/:id
VITE_GET_PARTS_API=/dealer/parts
VITE_CREATE_PART_API=/dealer/parts
VITE_GET_PART_DETAILS_API=/dealer/parts/:id
VITE_UPDATE_PART_API=/dealer/parts/:id
VITE_DELETE_PART_API=/dealer/parts/:id
